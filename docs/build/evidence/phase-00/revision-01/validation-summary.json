original('Debug','RayTracing')==0\ntry: check(copy/'bin')\nexcept AssertionError as error: evidence.append({'test':'new-safeguard-missing-tbb','result':'PASS rejected missing runtime','message':str(error)})\nelse: raise AssertionError('Missing TBB was accepted')\nstage(copy/'bin'); assert sha(missing)==DLL_SHA\nisolated_delete(missing,DLL_SHA); missing.write_bytes(b'wrong-runtime-content')\nwrong=sha(missing)\ntry: stage(copy/'bin')\nexcept AssertionError as error: evidence.append({'test':'refuse-mismatched-preexisting-output','result':'PASS','message':str(error)})\nelse: raise AssertionError('Corrupt output was overwritten')\nassert sha(missing)==wrong; isolated_delete(missing,wrong); stage(copy/'bin')\ntry: supply(root/'bin/Debug/RayTracing/SDL2.dll',missing,copy/'bin')\nexcept AssertionError as error: evidence.append({'test':'refuse-wrong-source-runtime','result':'PASS','message':str(error)})\nelse: raise AssertionError('Wrong source accepted')\ntracked=root/'bin/Debug/RayTracing/SDL2.dll'\ntry: supply(SOURCE,tracked,root/'bin')\nexcept AssertionError as error: evidence.append({'test':'refuse-protected-tracked-destination','result':'PASS','message':str(error)})\nelse: raise AssertionError('Protected target accepted')\nsdl=copy/'bin/Debug/RayTracing/SDL2.dll'; expected=sha(sdl); isolated_delete(sdl,expected)\nassert original('Debug','RayTracing')!=0\nshutil.copy2(tracked,sdl); assert sha(sdl)==expected\nbefore=sha(missing); again=stage(copy/'bin'); assert sha(missing)==before\nassert all(x['action']=='verified-existing; no write' for x in again)\nassert len(check(copy/'bin'))==8\nassert all(sha(path)==h for path,h in protected.items())\nresult={'result':'PASS','copy_root':str(copy),'records':evidence,'idempotence':again,'original_bytes_preserved':protected,'original_safeguard_gap':'Original safeguard passes with missing TBB; the new hash-verified supplement rejects it. Original SDL missing-file rejection remains effective.'}\n(root/'docs/build/evidence/phase-00/re