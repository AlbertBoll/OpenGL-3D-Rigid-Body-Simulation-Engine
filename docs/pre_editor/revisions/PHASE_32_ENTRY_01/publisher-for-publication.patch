+PHASE32_AUTHORITY = 'docs/pre_editor/evidence/phase-32-entry-01.json'
+PHASE32_AUTHORITY_SHA256 = '04704b19ec86e588743bd57788db86c6897cd71465e7709162210b8ada48fbe0'
+
+
+def phase32_correction_gate(repo, baseline, state):
+    raw = repo.path(PHASE32_AUTHORITY).read_bytes()
+    require(digest(raw) == PHASE32_AUTHORITY_SHA256, 'Phase32 Owner handoff authority changed')
+    h = json.loads(raw)
+    require(WORKFLOW == h['workflow'] == 'pre-editor' and h['phase'] == '32'
+            and baseline == h['baseline'], 'Phase32 requires the exact accepted Gizmo correction')
+    require(state['Current approved phase'] == '31' and state['Current approved tag'] == h['previous_tag']
+            and state['Next expected phase'] == '32', 'Phase32 predecessor state changed')
+    require(repo.text('branch', '--show-current') == state['Refactor branch'] == h['branch']
+            and state['Configured remote'] == h['remote'] and repo.push_destination(h['remote']) == h['destination'],
+            'Phase32 handoff branch or push destination changed')
+    require(repo.text('show', '-s', '--format=%T %P', baseline) == h['tree'] + ' ' + h['approved_parent'],
+            'Phase32 correction tree or sole approved parent changed')
+    archive = h['phase29']
+    for name, tag_object, commit in ((h['previous_tag'], h['previous_tag_object'], h['approved_parent']),
+                                     (h['correction_tag'], h['correction_tag_object'], baseline),
+                                     (archive['archive_tag'], archive['tag_object'], archive['commit'])):
+        ref = 'refs/tags/' + name
+        require(repo.text('cat-file', '-t', ref) == 'tag' and repo.text('rev-parse', ref) == tag_object
+                and repo.text('rev-parse', ref + '^{commit}') == commit, 'Phase32 handoff tag changed: ' + name)
+    for item in (h['previous_receipt'], h['correction_acceptance'], archive['evidence'], archive['original_transition']):
+        require(digest(repo.path(item['path']).read_bytes()) == item['sha256'],
+                'Phase32 handoff evidence changed: ' + item['path'])
+    require(digest(repo.journal('31').read_bytes()) == h['previous_journal_sha256'], 'Phase31 journal changed')
+    previous = repo.load('31')
+    tx = previous.get('transaction') or {}
+    require(previous['status'] == 'COMPLETE' and previous['receipt'] == h['previous_receipt']['path']
+            and previous['push_destination'] == h['destination'] and tx.get('commit') == h['approved_parent']
+            and tx.get('branch_pushed') is True and tx.get('tag_pushed') is True, 'Phase31 publication incomplete')
+    require(repo.git('show-ref', '--verify', '--quiet', 'refs/tags/pre-editor-phase-29-approved',
+                     allow_failure=True).returncode == 1 and not repo.journal('29').exists()
+            and not repo.path('pre-editor-checkpoints/phase-29.json').exists(), 'Phase29 archive disposition changed')
+    return {'authority': PHASE32_AUTHORITY, 'sha256': PHASE32_AUTHORITY_SHA256,
+            'baseline': baseline, 'phase31_approved_parent': h['approved_parent'], 'phase29_archive': archive['commit']}
+
