diff --git a/Jolt/Physics/Constraints/ConstraintPart/ContactResistanceConstraintPart.h b/Jolt/Physics/Constraints/ConstraintPart/ContactResistanceConstraintPart.h
new file mode 100644
index 0000000000000000000000000000000000000000..069a0a2b7abf4e2390e43c696ff18d3bb8e0a526
--- /dev/null
+++ b/Jolt/Physics/Constraints/ConstraintPart/ContactResistanceConstraintPart.h
@@ -0,0 +1,301 @@
+// GEngine authored contact resistance extension of Jolt 5.6.0.
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <Jolt/Math/Mat44.h>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+JPH_NAMESPACE_BEGIN
+
+/// Contact-local angular resistance. No body access, allocation or persistent load cache.
+class ContactResistanceConstraintPart
+{
+public:
+	struct Accumulator
+	{
+		double mSpin = 0.0;
+		double mRollingU = 0.0;
+		double mRollingV = 0.0;
+	};
+
+	struct Properties
+	{
+		Float3 mInverse1[3];
+		Float3 mInverse2[3];
+		double mU[3];
+		double mV[3];
+		double mSpinK;
+		double mA;
+		double mB;
+		double mC;
+	};
+
+	struct Result
+	{
+		bool mValid = true;
+		bool mApplied = false;
+		uint32 mRootIterations = 0;
+		Vec3 mSpinImpulse = Vec3::sZero();
+		Vec3 mRollingImpulse = Vec3::sZero();
+	};
+
+	static constexpr uint32 cMaxRootIterations = 48;
+
+	/// Prepare once per contact/collision substep from authoritative responsive inverse inertias.
+	static bool Prepare(Mat44Arg inInverse1, Mat44Arg inInverse2, Vec3Arg inNormal, Properties &out)
+	{
+		// The invalid marker also makes a failed preparation fail closed during solving.
+		out.mSpinK = std::numeric_limits<double>::quiet_NaN();
+		for (uint i = 0; i < 3; ++i)
+		{
+			const Vec3 column1 = inInverse1.GetColumn3(i), column2 = inInverse2.GetColumn3(i);
+			if (!Finite(column1) || !Finite(column2))
+				return false;
+			column1.StoreFloat3(&out.mInverse1[i]);
+			column2.StoreFloat3(&out.mInverse2[i]);
+		}
+
+		double n[3];
+		if (!Normal(inNormal, n))
+			return false;
+		const double ax = std::abs(n[0]), ay = std::abs(n[1]), az = std::abs(n[2]);
+		const uint seed = ax <= ay && ax <= az? 0 : (ay <= az? 1 : 2);
+		double axis[3] = { 0.0, 0.0, 0.0 };
+		axis[seed] = 1.0;
+		Cross(n, axis, out.mU);
+		const double u_length = std::sqrt(Dot(out.mU, out.mU));
+		if (!(u_length > 0.0) || !std::isfinite(u_length))
+			return false;
+		for (uint i = 0; i < 3; ++i)
+			out.mU[i] /= u_length;
+		Cross(n, out.mU, out.mV);
+
+		const Vec3 normal{ float(n[0]), float(n[1]), float(n[2]) };
+		const Vec3 response1 = Multiply(out.mInverse1, normal);
+		const Vec3 response2 = Multiply(out.mInverse2, normal);
+		if (!Finite(response1) || !Finite(response2))
+			return false;
+		const double nf[3] = { normal.GetX(), normal.GetY(), normal.GetZ() };
+		const double response[3] = {
+			double(response1.GetX()) + response2.GetX(),
+			double(response1.GetY()) + response2.GetY(),
+			double(response1.GetZ()) + response2.GetZ()
+		};
+		const double spin_k = Dot(nf, response);
+		double ku[3], kv[3];
+		MultiplySum(out, out.mU, ku);
+		MultiplySum(out, out.mV, kv);
+		out.mA = Dot(out.mU, ku);
+		out.mB = Dot(out.mU, kv);
+		out.mC = Dot(out.mV, kv);
+		if (!(spin_k >= 0.0 && out.mA >= 0.0 && out.mC >= 0.0)
+			|| !std::isfinite(spin_k) || !std::isfinite(out.mA)
+			|| !std::isfinite(out.mB) || !std::isfinite(out.mC))
+			return false;
+		out.mSpinK = spin_k;
+		return true;
+	}
+
+	/// Apply only the delta of the accumulated constraint, never a fresh budget per iteration.
+	/// Both endpoint Float32 results are validated before either reference is published.
+	static Result Solve(const Properties &inProperties, Vec3Arg inNormal, float inNormalLambda,
+		float inSpinLength, float inRollingLength, Accumulator &ioAccumulator,
+		Vec3 &ioAngular1, Vec3 &ioAngular2)
+	{
+		Result result;
+		if (!std::isfinite(inSpinLength) || !std::isfinite(inRollingLength)
+			|| !(inSpinLength >= 0.0f && inRollingLength >= 0.0f))
+			return Invalid(result);
+		if (inSpinLength == 0.0f && inRollingLength == 0.0f)
+			return result;
+		if (!std::isfinite(inNormalLambda)
+			|| !std::isfinite(inProperties.mSpinK) || !std::isfinite(inProperties.mA)
+			|| !std::isfinite(inProperties.mB) || !std::isfinite(inProperties.mC)
+			|| !(inProperties.mSpinK >= 0.0 && inProperties.mA >= 0.0 && inProperties.mC >= 0.0)
+			|| !std::isfinite(ioAccumulator.mSpin) || !std::isfinite(ioAccumulator.mRollingU)
+			|| !std::isfinite(ioAccumulator.mRollingV) || !Finite(ioAngular1) || !Finite(ioAngular2))
+			return Invalid(result);
+
+		double n[3];
+		if (!Normal(inNormal, n))
+			return Invalid(result);
+		const Vec3 normal{ float(n[0]), float(n[1]), float(n[2]) };
+		Vec3 angular1 = ioAngular1, angular2 = ioAngular2;
+		Accumulator next_accumulator = ioAccumulator;
+		const double normal_lambda = std::max(0.0, double(inNormalLambda));
+
+		if (inSpinLength > 0.0f && inProperties.mSpinK > 0.0)
+		{
+			const double relative[3] = {
+				double(angular2.GetX()) - angular1.GetX(),
+				double(angular2.GetY()) - angular1.GetY(),
+				double(angular2.GetZ()) - angular1.GetZ()
+			};
+			const double nf[3] = { normal.GetX(), normal.GetY(), normal.GetZ() };
+			const double spin = Dot(relative, nf);
+			const double limit = double(inSpinLength) * normal_lambda;
+			const double next = std::clamp(ioAccumulator.mSpin - spin / inProperties.mSpinK, -limit, limit);
+			const double delta = next - ioAccumulator.mSpin;
+			if (!std::isfinite(delta) || std::abs(delta) > std::numeric_limits<float>::max())
+				return Invalid(result);
+			const float applied = float(delta);
+			if (applied != 0.0f)
+			{
+				result.mSpinImpulse = normal * applied;
+				if (!Apply(inProperties, result.mSpinImpulse, angular1, angular2))
+					return Invalid(result);
+				next_accumulator.mSpin += applied;
+				result.mApplied = true;
+			}
+		}
+
+		if (inRollingLength > 0.0f && inProperties.mA > 0.0 && inProperties.mC > 0.0)
+		{
+			const double a = inProperties.mA, b = inProperties.mB, c = inProperties.mC;
+			const double relative[3] = {
+				double(angular2.GetX()) - angular1.GetX(),
+				double(angular2.GetY()) - angular1.GetY(),
+				double(angular2.GetZ()) - angular1.GetZ()
+			};
+			const double velocity_u = Dot(relative, inProperties.mU);
+			const double velocity_v = Dot(relative, inProperties.mV);
+			const double rhs_u = a * ioAccumulator.mRollingU + b * ioAccumulator.mRollingV - velocity_u;
+			const double rhs_v = b * ioAccumulator.mRollingU + c * ioAccumulator.mRollingV - velocity_v;
+			const double limit = double(inRollingLength) * normal_lambda;
+			double next_u = 0.0, next_v = 0.0;
+			const auto solve = [&](double alpha)
+			{
+				const double scale = std::max({ a, c, alpha });
+				const double aa = a / scale + alpha / scale, bb = b / scale, cc = c / scale + alpha / scale;
+				const double determinant = aa * cc - bb * bb;
+				if (!(determinant > 0.0) || !std::isfinite(determinant))
+					return false;
+				const double scaled_u = rhs_u / scale, scaled_v = rhs_v / scale;
+				next_u = (cc * scaled_u - bb * scaled_v) / determinant;
+				next_v = (aa * scaled_v - bb * scaled_u) / determinant;
+				return std::isfinite(next_u) && std::isfinite(next_v);
+			};
+			if (limit > 0.0)
+			{
+				if (!solve(0.0))
+					return Invalid(result);
+				if (std::hypot(next_u, next_v) > limit)
+				{
+					double low = 0.0, high = std::hypot(rhs_u, rhs_v) / limit;
+					if (!std::isfinite(high))
+						return Invalid(result);
+					for (uint32 i = 0; i < cMaxRootIterations; ++i)
+					{
+						const double mid = (low + high) * 0.5;
+						if (!solve(mid))
+							return Invalid(result);
+						++result.mRootIterations;
+						if (std::hypot(next_u, next_v) > limit)
+							low = mid;
+						else
+							high = mid;
+					}
+					if (!solve(high))
+						return Invalid(result);
+				}
+			}
+			const double delta_u = next_u - ioAccumulator.mRollingU;
+			const double delta_v = next_v - ioAccumulator.mRollingV;
+			double candidate[3];
+			for (uint i = 0; i < 3; ++i)
+			{
+				candidate[i] = inProperties.mU[i] * delta_u + inProperties.mV[i] * delta_v;
+				if (!(std::abs(candidate[i]) <= std::numeric_limits<float>::max()))
+					return Invalid(result);
+			}
+			result.mRollingImpulse = Vec3(float(candidate[0]), float(candidate[1]), float(candidate[2]));
+			if (result.mRollingImpulse != Vec3::sZero())
+			{
+				if (!Apply(inProperties, result.mRollingImpulse, angular1, angular2))
+					return Invalid(result);
+				const double applied[3] = {
+					result.mRollingImpulse.GetX(), result.mRollingImpulse.GetY(), result.mRollingImpulse.GetZ()
+				};
+				next_accumulator.mRollingU += Dot(inProperties.mU, applied);
+				next_accumulator.mRollingV += Dot(inProperties.mV, applied);
+				result.mApplied = true;
+			}
+		}
+
+		if (!std::isfinite(next_accumulator.mSpin) || !std::isfinite(next_accumulator.mRollingU)
+			|| !std::isfinite(next_accumulator.mRollingV))
+			return Invalid(result);
+		ioAccumulator = next_accumulator;
+		ioAngular1 = angular1;
+		ioAngular2 = angular2;
+		return result;
+	}
+
+private:
+	static bool Finite(Vec3Arg inValue)
+	{
+		return std::isfinite(inValue.GetX()) && std::isfinite(inValue.GetY()) && std::isfinite(inValue.GetZ());
+	}
+
+	static Result Invalid(Result inResult)
+	{
+		inResult.mValid = false;
+		inResult.mApplied = false;
+		return inResult;
+	}
+
+	static double Dot(const double *inA, const double *inB)
+	{
+		return inA[0] * inB[0] + inA[1] * inB[1] + inA[2] * inB[2];
+	}
+
+	static void Cross(const double *inA, const double *inB, double *out)
+	{
+		out[0] = inA[1] * inB[2] - inA[2] * inB[1];
+		out[1] = inA[2] * inB[0] - inA[0] * inB[2];
+		out[2] = inA[0] * inB[1] - inA[1] * inB[0];
+	}
+
+	static bool Normal(Vec3Arg inNormal, double *out)
+	{
+		out[0] = inNormal.GetX(); out[1] = inNormal.GetY(); out[2] = inNormal.GetZ();
+		const double length = std::sqrt(Dot(out, out));
+		if (!(length > 0.0) || !std::isfinite(length))
+			return false;
+		for (uint i = 0; i < 3; ++i)
+			out[i] /= length;
+		return true;
+	}
+
+	static Vec3 Multiply(const Float3 *inColumns, Vec3Arg inVector)
+	{
+		// Same Float32 operation order as Mat44::Multiply3x3 on the pinned x64 build.
+		return (Vec3(inColumns[0]) * inVector.GetX() + Vec3(inColumns[1]) * inVector.GetY()) + Vec3(inColumns[2]) * inVector.GetZ();
+	}
+
+	static void MultiplySum(const Properties &inProperties, const double *inVector, double *out)
+	{
+		for (int row = 0; row < 3; ++row)
+			out[row] = (double(inProperties.mInverse1[0][row]) + inProperties.mInverse2[0][row]) * inVector[0]
+				+ (double(inProperties.mInverse1[1][row]) + inProperties.mInverse2[1][row]) * inVector[1]
+				+ (double(inProperties.mInverse1[2][row]) + inProperties.mInverse2[2][row]) * inVector[2];
+	}
+
+	static bool Apply(const Properties &inProperties, Vec3Arg inImpulse, Vec3 &ioAngular1, Vec3 &ioAngular2)
+	{
+		const Vec3 next1 = ioAngular1 - Multiply(inProperties.mInverse1, inImpulse);
+		const Vec3 next2 = ioAngular2 + Multiply(inProperties.mInverse2, inImpulse);
+		if (!Finite(inImpulse) || !Finite(next1) || !Finite(next2))
+			return false;
+		ioAngular1 = next1;
+		ioAngular2 = next2;
+		return true;
+	}
+};
+
+static_assert(sizeof(ContactResistanceConstraintPart::Properties) == 152);
+static_assert(sizeof(ContactResistanceConstraintPart::Accumulator) == 24);
+
+JPH_NAMESPACE_END
