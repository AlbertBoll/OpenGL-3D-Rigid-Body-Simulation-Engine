 #ifdef JPH_DEBUG_RENDERER
 	#include <Jolt/Renderer/DebugRenderer.h>
 #endif // JPH_DEBUG_RENDERER
 
 JPH_NAMESPACE_BEGIN
+
+#ifdef JPH_GENGINE_PHASE26_OBSERVATION
+namespace QualificationObservation
+{
+
+// These definitions live in the SDK object, rather than inline in the header,
+// so the adapter and direct fixture use the same sink and TLS in the final EXE.
+const uint64 kObservationAbiSentinel = kExpectedObservationAbiSentinel;
+struct BaseJobPoolLayout : JobSystem
+{
+	static constexpr uint64 SlotBytes = FixedSizeFreeList<Job>::ObjectStorageSize;
+};
+const uint64 kBaseJobSlotBytes = BaseJobPoolLayout::SlotBytes;
+const uint64 kBaseJobPoolBytes = uint64(cMaxPhysicsJobs) * kBaseJobSlotBytes;
+const uint64 kBroadPhaseNodeBytes = sizeof(BodyID);
+const uint64 kBroadPhaseCenterBytes = sizeof(Vec3);
+static std::atomic<Sink *> sSink { nullptr };
+static std::atomic<uint32> sUpdateActive { 0 };
+static thread_local Context sContext { nullptr, 0, 0, ~uint32(0), Phase::None, ArenaSite::Unknown };
+static thread_local float sAcceptedCCDNormalLambda = 0.0f;
+static constexpr uint32 cCCDCandidateSlots = 4096;
+struct CandidateSlot
+{
+	CCDRecord record;
+	std::atomic<uint32> valid { 0 };
+};
+static_assert(sizeof(CandidateSlot) <= 96);
+const TypeSizes kObservationTypeSizes {
+	sizeof(PhysicsUpdateContext::Step),
+	sizeof(PhysicsUpdateContext::Step::CCDBody),
+	ContactConstraintManager::cMaxConstraintSize,
+	JPH_RVECTOR_ALIGNMENT,
+	sizeof(BodyID),
+	sizeof(BodyPair),
+	sizeof(Constraint *),
+	sizeof(uint32),
+	sizeof(CandidateSlot),
+	cCCDCandidateSlots
+};
+static CandidateSlot sCCDCandidates[cCCDCandidateSlots];
+
+static uint32 sExpectedSize(EventKind inKind) noexcept
+{
+	switch (inKind)
+	{
+	case EventKind::Point:
+	case EventKind::CCDManifoldPoint:
+		return sizeof(PointRecord);
+	case EventKind::CCDCandidate:
+	case EventKind::CCDAccepted:
+		return sizeof(CCDRecord);
+	case EventKind::RetiredUnpersisted:
+	case EventKind::CacheLifecycle:
+		return sizeof(LifetimeRecord);
+	case EventKind::Work:
+		return sizeof(WorkRecord);
+	case EventKind::Phase:
+		return sizeof(PhaseRecord);
+	case EventKind::Storage:
+		return sizeof(StorageRecord);
+	case EventKind::Heap:
+		return sizeof(HeapRecord);
+	case EventKind::Identity:
+		return sizeof(IdentityRecord);
+	case EventKind::Failure:
+		return sizeof(FailureRecord);
+	}
+	return 0;
+}
+
+static void sFail(Sink *inSink, const Context &inContext, FailureCode inCode, uint64 inDetail) noexcept
+{
+	if (inSink != nullptr && inSink->publish != nullptr)
+	{
+		FailureRecord record { inContext, inCode, inSink->substeps, inDetail };
+		inSink->publish(inSink->user, EventKind::Failure, &record, sizeof(record));
+	}
+}
+
+bool InstallSink(Sink *inSink) noexcept
+{
+	if (inSink == nullptr || inSink->publish == nullptr || inSink->epoch == 0 || sUpdateActive.load(std::memory_order_acquire) != 0)
+		return false;
+	Sink *expected = nullptr;
+	return sSink.compare_exchange_strong(expected, inSink, std::memory_order_acq_rel);
+}
+
+bool RemoveSink(Sink *inSink) noexcept
+{
+	if (sUpdateActive.load(std::memory_order_acquire) != 0)
+		return false;
+	return sSink.compare_exchange_strong(inSink, nullptr, std::memory_order_acq_rel);
+}
+
+Sink *GetSink() noexcept
+{
+	return sSink.load(std::memory_order_acquire);
+}
+
+Context CurrentContext() noexcept
+{
+	if (sContext.world != nullptr || sContext.phase != Phase::None || sContext.site != ArenaSite::Unknown)
+		return sContext;
+	Sink *sink = GetSink();
+	if (sink == nullptr)
+		return sContext;
+	if (sUpdateActive.load(std::memory_order_acquire) != 0)
+		return { nullptr, sink->epoch, sink->update, ~uint32(0), Phase::None, ArenaSite::Unknown };
+	return { sink->world, sink->epoch, 0, ~uint32(0), Phase::Lifetime, ArenaSite::Unknown };
+}
+
+uint64 ClockNowNs() noexcept
+{
+	return uint64(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+void PublishSynthetic(const Context &inContext, EventKind inKind, const void *inRecord, uint32 inBytes) noexcept
+{
+	Sink *sink = GetSink();
+	if (sink == nullptr)
+		return;
+	if (inContext.world != sink->world)
+	{
+		sFail(sink, inContext, inContext.world == nullptr? FailureCode::Contextless : FailureCode::WrongOwner, uint64(reinterpret_cast<uintptr_t>(inContext.world)));
+		return;
+	}
+	if (inContext.epoch != sink->epoch)
+	{
+		sFail(sink, inContext, FailureCode::WrongEpoch, inContext.epoch);
+		return;
+	}
+	if (inContext.update == 0 && (inContext.phase != Phase::Lifetime
+		|| (inKind != EventKind::Heap && inKind != EventKind::Storage && inKind != EventKind::Identity && inKind != EventKind::Failure)))
+	{
+		sFail(sink, inContext, FailureCode::LateUpdate, 0);
+		return;
+	}
+	if (inContext.update != 0 && inContext.update != sink->update)
+	{
+		sFail(sink, inContext, FailureCode::LateUpdate, inContext.update);
+		return;
+	}
+	const bool boundary_allocation = inContext.update != 0 && inContext.substep == ~uint32(0)
+		&& inContext.phase == Phase::SharedStepWork
+		&& (inKind == EventKind::Heap || inKind == EventKind::Storage || inKind == EventKind::Identity);
+	if (inContext.update != 0 && inContext.substep >= sink->substeps && !boundary_allocation)
+	{
+		sFail(sink, inContext, FailureCode::OutOfRangeSubstep, inContext.substep);
+		return;
+	}
+	if (inRecord == nullptr || sExpectedSize(inKind) != inBytes)
+	{
+		sFail(sink, inContext, FailureCode::InvalidRecordSize, inBytes);
+		return;
+	}
+	const Context &record_context = *static_cast<const Context *>(inRecord);
+	if (record_context.world != inContext.world || record_context.epoch != inContext.epoch || record_context.update != inContext.update || record_context.substep != inContext.substep)
+	{
+		sFail(sink, inContext, FailureCode::SinkMismatch, 0);
+		return;
+	}
+	sink->publish(sink->user, inKind, inRecord, inBytes);
+}
+
+void PublishRecord(EventKind inKind, const void *inRecord, uint32 inBytes) noexcept
+{
+	Context context = CurrentContext();
+	Sink *sink = GetSink();
+	if (sink != nullptr && sUpdateActive.load(std::memory_order_acquire) == 0 && context.update != 0)
+	{
+		sFail(sink, context, FailureCode::LateUpdate, context.update);
+		return;
+	}
+	PublishSynthetic(context, inKind, inRecord, inBytes);
+}
+
+void ReportFailure(FailureCode inCode, uint64 inDetail) noexcept
+{
+	sFail(GetSink(), CurrentContext(), inCode, inDetail);
+}
+
+void ReportWork(WorkKind inKind, uint32 inCount, uint32 inChanged, uint32 inRootIterations) noexcept
+{
+	WorkRecord record { CurrentContext(), inKind, inCount, inChanged, inRootIterations };
+	PublishRecord(EventKind::Work, &record, sizeof(record));
+}
+
+void ReportStorage(ArenaSite inSite, StorageAction inAction, const void *inPointer, uint64 inRequestedBytes, uint64 inAlignedBytes, uint32 inCount) noexcept
+{
+	StorageRecord record { CurrentContext(), uint64(reinterpret_cast<uintptr_t>(inPointer)), inRequestedBytes, inAlignedBytes, 0, inCount, inAction };
+	record.context.site = inSite;
+	PublishRecord(EventKind::Storage, &record, sizeof(record));
+}
+
+UpdateScope::UpdateScope(const PhysicsSystem *inWorld, uint32 inSubsteps) noexcept : mPrevious(sContext), mEntered(false)
+{
+	Sink *sink = GetSink();
+	if (sink == nullptr)
+		return;
+	if (sink->world != inWorld)
+	{
+		sFail(sink, CurrentContext(), FailureCode::WrongOwner, uint64(reinterpret_cast<uintptr_t>(inWorld)));
+		return;
+	}
+	if (sink->update == 0)
+	{
+		sFail(sink, CurrentContext(), FailureCode::LateUpdate, 0);
+		return;
+	}
+	if (sink->substeps != inSubsteps || inSubsteps == 0)
+	{
+		sFail(sink, CurrentContext(), FailureCode::OutOfRangeSubstep, inSubsteps);
+		return;
+	}
+	if (sContext.world != nullptr)
+	{
+		sFail(sink, sContext, FailureCode::NestedUpdate, 0);
+		return;
+	}
+	uint32 expected = 0;
+	if (!sUpdateActive.compare_exchange_strong(expected, 1, std::memory_order_acq_rel))
+	{
+		sFail(sink, CurrentContext(), FailureCode::ConcurrentUpdate, 0);
+		return;
+	}
+	sContext = { inWorld, sink->epoch, sink->update, 0, Phase::Update, ArenaSite::Unknown };
+	mEntered = true;
+}
+
+UpdateScope::~UpdateScope() noexcept
+{
+	if (mEntered)
+	{
+		sContext = mPrevious;
+		sUpdateActive.store(0, std::memory_order_release);
+	}
+}
+
+StepScope::StepScope(const PhysicsSystem *inWorld, uint32 inSubstep) noexcept : mPrevious(sContext), mEntered(false)
+{
+	Sink *sink = GetSink();
+	if (sink == nullptr)
+		return;
+	if (sUpdateActive.load(std::memory_order_acquire) == 0)
+	{
+		sFail(sink, CurrentContext(), FailureCode::LateUpdate, sink->update);
+		return;
+	}
+	if (sink->world != inWorld || (sContext.world != nullptr && sContext.world != inWorld))
+	{
+		sFail(sink, CurrentContext(), FailureCode::WrongOwner, uint64(reinterpret_cast<uintptr_t>(inWorld)));
+		return;
+	}
+	if (sContext.world != nullptr && (sContext.epoch != sink->epoch || sContext.update != sink->update))
+	{
+		sFail(sink, sContext, sContext.epoch != sink->epoch? FailureCode::WrongEpoch : FailureCode::LateUpdate, sContext.update);
+		return;
+	}
+	if (inSubstep >= sink->substeps)
+	{
+		sFail(sink, CurrentContext(), FailureCode::OutOfRangeSubstep, inSubstep);
+		return;
+	}
+	sContext = { inWorld, sink->epoch, sink->update, inSubstep, Phase::SharedStepWork, ArenaSite::Unknown };
+	mEntered = true;
+}
+
+StepScope::~StepScope() noexcept
+{
+	if (mEntered)
+		sContext = mPrevious;
+}
+
+PhaseScope::PhaseScope(Phase inPhase) noexcept : mPrevious(sContext), mStart(0), mEntered(GetSink() != nullptr)
+{
+	if (mEntered)
+	{
+		if (sContext.world == nullptr)
+			sContext = CurrentContext();
+		sContext.phase = inPhase;
+		mStart = ClockNowNs();
+	}
+}
+
+PhaseScope::~PhaseScope() noexcept
+{
+	if (mEntered)
+	{
+		PhaseRecord record { sContext, sContext.phase, 1, ClockNowNs() - mStart };
+		PublishRecord(EventKind::Phase, &record, sizeof(record));
+		sContext = mPrevious;
+	}
+}
+
+SiteScope::SiteScope(ArenaSite inSite) noexcept : mPrevious(sContext), mEntered(GetSink() != nullptr)
+{
+	if (mEntered)
+	{
+		if (sContext.world == nullptr)
+			sContext = CurrentContext();
+		sContext.site = inSite;
+	}
+}
+
+SiteScope::~SiteScope() noexcept
+{
+	if (mEntered)
+		sContext = mPrevious;
+}
+
+} // namespace QualificationObservation
+
+static uint32 sObservationStepIndex(const PhysicsUpdateContext::Step *inStep) noexcept
+{
+	if (inStep == nullptr || inStep->mContext == nullptr)
+	{
+		QualificationObservation::ReportFailure(QualificationObservation::FailureCode::Contextless);
+		return ~uint32(0);
+	}
+	const PhysicsUpdateContext *context = inStep->mContext;
+	const uintptr_t begin = reinterpret_cast<uintptr_t>(context->mSteps.data());
+	const uintptr_t address = reinterpret_cast<uintptr_t>(inStep);
