+
+// Point identity uses the complete BodyID value, including its sequence number.
+// Discrete Point uses COMLocal. CCDManifoldPoint uses WorldAtImpact for candidate
+// manifold ordinals and COMLocal with ordinal UINT32_MAX for the accepted response.
+struct PointRecord
+{
+	Context context;
+	uint32 body1;
+	uint32 subshape1;
+	uint32 body2;
+	uint32 subshape2;
+	uint32 ordinal;
+	AnchorSpace space;
