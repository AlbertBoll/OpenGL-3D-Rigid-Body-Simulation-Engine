+};
+
+struct IdentityRecord
+{
+	Context context;
+	uint32 sdk_body_id;
+	uint32 managed_index;
+	uint64 managed_generation;
+	uint64 managed_registry;
+	IdentityAction action;
+};
+
+struct FailureRecord
+{
+	Context context;
+	FailureCode code;
+	uint32 expected_substeps;
+	uint64 detail;
+};
+
+// The callback must copy the record before returning. It must not allocate, lock,
+// throw, or retain SDK pointers. SDK workers never own recorder memory.
+struct Sink
+{
+	void *user;
+	const PhysicsSystem *world;
+	uint64 epoch;
+	uint64 update;
+	uint32 substeps;
+	void (*publish)(void *, EventKind, const void *, uint32) noexcept;
+};
+
+struct TypeSizes
+{
+	uint32 update_step;
+	uint32 ccd_body;
+	uint32 max_contact_constraint;
+	uint32 arena_alignment;
+	uint32 body_id;
+	uint32 body_pair;
+	uint32 constraint_pointer;
+	uint32 island_index;
+	uint32 ccd_candidate_slot;
+	uint32 ccd_candidate_slots;
+};
+
+inline constexpr uint64 kExpectedObservationAbiSentinel = 0x5032364f42533101ULL;
+extern const uint64 kObservationAbiSentinel;
+extern const TypeSizes kObservationTypeSizes;
+extern const uint64 kBaseJobPoolBytes;
+extern const uint64 kBaseJobSlotBytes;
+extern const uint64 kBroadPhaseNodeBytes;
+extern const uint64 kBroadPhaseCenterBytes;
+
+bool InstallSink(Sink *inSink) noexcept;
+bool RemoveSink(Sink *inSink) noexcept;
+Sink *GetSink() noexcept;
+Context CurrentContext() noexcept;
+uint64 ClockNowNs() noexcept;
+void PublishRecord(EventKind inKind, const void *inRecord, uint32 inBytes) noexcept;
+void PublishSynthetic(const Context &inContext, EventKind inKind, const void *inRecord, uint32 inBytes) noexcept;
+void ReportFailure(FailureCode inCode, uint64 inDetail = 0) noexcept;
+void ReportWork(WorkKind inKind, uint32 inCount = 1, uint32 inChanged = 0, uint32 inRootIterations = 0) noexcept;
+void ReportStorage(ArenaSite inSite, StorageAction inAction, const void *inPointer, uint64 inRequestedBytes, uint64 inAlignedBytes, uint32 inCount = 1) noexcept;
+
+class UpdateScope
+{
+public:
+	explicit UpdateScope(const PhysicsSystem *inWorld, uint32 inSubsteps) noexcept;
+	~UpdateScope() noexcept;
+	UpdateScope(const UpdateScope &) = delete;
+	UpdateScope &operator=(const UpdateScope &) = delete;
+
+private:
+	Context mPrevious;
+	bool mEntered;
+};
+
+class StepScope
+{
+public:
+	StepScope(const PhysicsSystem *inWorld, uint32 inSubstep) noexcept;
+	~StepScope() noexcept;
+	StepScope(const StepScope &) = delete;
+	StepScope &operator=(const StepScope &) = delete;
+
+private:
+	Context mPrevious;
