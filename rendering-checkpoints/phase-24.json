  "findings": [
    {
      "disposition": "Track pending shader ownership, clean every failure immediately, retire intermediate names after link and delete each program once without cleanup allocation.",
      "finding": "Incremental compile/link failures could retain partial state; destruction allocated an attached-shader enumeration buffer.",
      "status": "RESOLVED"
    },
    {
      "disposition": "Retain move-only API and transfer containers through unique ownership; actual allocation denial verifies move/destruction and compile-unwind paths.",
      "finding": "Shader was already move-only, but CPU containers need allocation-free transfer on the recorded MSVC toolchain.",
      "status": "RESOLVED"
    },
    {
      "disposition": "C++20 variant factories return error code/stage/source/log; compatibility exception carries identical fields. Manager publishes complete candidates without rescanning; signed missing locations are cached.",
      "finding": "Creation failures lacked structured return values and ShaderManager repeated Link uniform discovery.",
      "status": "RESOLVED"
    }
  ],
